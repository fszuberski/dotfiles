{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-right": ["cpu", "memory", "network", "bluetooth", "pulseaudio", "clock", "tray"],
  "cpu": {
    "interval": 2,
    "format": "CPU {usage:>3}%"
  },
  "memory": {
    "interval": 2,
    "format": "RAM {percentage:>3}%"
  },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },
  "network": {
    "rfkill": false,
    "interval": 1,
    "format-ethernet": "󰈀 Wired  ↓ {bandwidthDownBits:>12} ↑ {bandwidthUpBits:>12}",
    "format-wifi": "{icon} {essid} {signalStrength}%  ↓ {bandwidthDownBits:>12} ↑ {bandwidthUpBits:>12}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-linked": "󰈀 Connecting",
    "format-disconnected": "󰤭 Offline",
    "on-click": "networkmanager_dmenu"
  },
  "bluetooth": {
    "format": "󰂯 BT {status}",
    "format-off": "󰂲 BT off",
    "format-disabled": "󰂲 BT disabled",
    "format-on": "󰂯 BT on",
    "format-connected": "󰂱 BT connected ({num_connections})",
    "format-no-controller": "󰂲 BT unavailable",
    "on-click": "rofi-bluetooth"
  },
  "clock": { "format": "{:%Y-%m-%d %H:%M:%S}", "interval": 1 },
  "tray": { "spacing": 10 }
}
