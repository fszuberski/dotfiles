{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["network", "bluetooth", "pulseaudio", "clock", "tray"],
  "sway/window": { "max-length": 60 },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },
  "network": {
    "rfkill": false,
    "format-ethernet": "Wired connected",
    "format-wifi": "Wi-Fi {essid} {signalStrength}%",
    "format-linked": "Network connecting",
    "format-disconnected": "Network disconnected",
    "on-click": "networkmanager_dmenu"
  },
  "bluetooth": {
    "format": "BT {status}",
    "format-off": "BT off",
    "format-disabled": "BT disabled",
    "format-on": "BT on",
    "format-connected": "BT connected ({num_connections})",
    "format-no-controller": "BT unavailable",
    "on-click": "rofi-bluetooth"
  },
  "clock": { "format": "{:%Y-%m-%d %H:%M:%S}", "interval": 1 },
  "tray": { "spacing": 10 }
}
