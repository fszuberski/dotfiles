{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-right": ["tray", "cpu", "custom/cpu-temperature", "custom/gpu-status", "memory", "network#traffic", "custom/vpn", "network", "bluetooth", "custom/notifications", "pulseaudio", "battery", "clock", "custom/power"],
  "cpu": {
    "interval": 2,
    "format": "<span foreground='#7aa2f7'></span> {usage:>3}%"
  },
  "custom/cpu-temperature": {
    "exec": "sh $HOME/.config/waybar/cpu-temperature.sh",
    "interval": 2,
    "tooltip": false
  },
  "custom/gpu-status": {
    "exec": "sh $HOME/.config/waybar/gpu-status.sh",
    "format": "<span foreground='#7aa2f7'>󰢮</span> {}",
    "hide-empty-text": true,
    "interval": 2,
    "tooltip": false
  },
  "memory": {
    "interval": 2,
    "format": "<span foreground='#7aa2f7'></span>  {used:.1f}/{total:.1f} GiB"
  },
  "pulseaudio": {
    "format": "<span foreground='#7aa2f7'>{icon}</span> {volume}%",
    "format-muted": "<span foreground='#f7768e'>󰖁</span> {volume}%",
    "states": { "zero": 0 },
    "format-zero": "<span foreground='#f7768e'>󰖁</span> {volume}%",
    "format-bluetooth-zero": "<span foreground='#f7768e'>󰖁</span> {volume}%",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "pavucontrol"
  },
  "network#traffic": {
    "rfkill": false,
    "interval": 1,
    "format-ethernet": "<span foreground='#9ece6a'>↓</span> {bandwidthDownBits:>12} <span foreground='#e0af68'>↑</span> {bandwidthUpBits:>12}",
    "format-wifi": "<span foreground='#9ece6a'>↓</span> {bandwidthDownBits:>12} <span foreground='#e0af68'>↑</span> {bandwidthUpBits:>12}",
    "format-linked": "",
    "format-disconnected": "",
    "tooltip": false
  },
  "custom/vpn": {
    "exec": "sh $HOME/.config/waybar/vpn-status.sh",
    "return-type": "json",
    "format": "{text}",
    "interval": 5
  },
  "network": {
    "rfkill": false,
    "interval": 1,
    "format-ethernet": "<span foreground='#7aa2f7'>󰤨</span>",
    "format-wifi": "<span foreground='#9ece6a'>{icon}</span>",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-linked": "<span foreground='#f7768e'>󰤭</span>",
    "format-disconnected": "<span foreground='#f7768e'>󰤭</span>",
    "tooltip-format-ethernet": "Wired: {ifname} ({ipaddr})",
    "tooltip-format-wifi": "Wi-Fi: {essid} ({signalStrength}%)",
    "tooltip-format-linked": "Network connecting",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "networkmanager_dmenu"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "rofi-bluetooth"
  },
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "default": "<span foreground='#7aa2f7'>󰂚</span>",
      "dnd-notification": "<span foreground='#ff9e64'>󰂛</span>",
      "dnd-none": "<span foreground='#ff9e64'>󰂛</span>",
      "dnd-inhibited-notification": "<span foreground='#ff9e64'>󰂛</span>",
      "dnd-inhibited-none": "<span foreground='#ff9e64'>󰂛</span>"
    },
    "on-click": "swaync-client --toggle-panel",
    "restart-interval": 5,
    "exec-on-event": false
  },
  "battery": {
    "interval": 30,
    "states": { "warning": 49, "critical": 19 },
    "format": "<span foreground='#e0af68'>{icon}</span> {capacity}%",
    "format-warning": "<span foreground='#ff9e64'>{icon}</span> {capacity}%",
    "format-critical": "<span foreground='#f7768e'>{icon}</span> {capacity}%",
    "format-charging": "<span foreground='#9ece6a'>󰂄</span> {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  },
  "clock": { "format": "{:%Y-%m-%d %H:%M:%S}", "interval": 1 },
  "custom/power": {
    "format": "󰣇",
    "tooltip-format": "Power menu",
    "on-click": "sh $HOME/.config/waybar/power-menu.sh"
  },
  "tray": { "spacing": 10 }
}
