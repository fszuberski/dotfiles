{
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["pulseaudio", "clock", "tray"],
  "sway/window": { "max-length": 60 },
  "pulseaudio": {
    "format": "Vol {volume}%",
    "format-muted": "Muted",
    "on-click": "pavucontrol"
  },
  "clock": { "format": "{:%a %d %b  %H:%M}" },
  "tray": { "spacing": 10 }
}
